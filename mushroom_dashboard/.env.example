# Django core
DJANGO_SECRET_KEY=replace-with-a-strong-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-service-name.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://your-service-name.onrender.com

# Database (PostgreSQL URL)
# Supabase: use the TRANSACTION pooler port (6543), not the session pooler
# (5432). Session mode caps concurrent clients at the pool size (15) and
# serverless hosts such as Vercel exceed that quickly.
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Seconds to reuse a database connection between requests. Lower this (0) if
# the host is serverless and you hit connection-limit errors.
DB_CONN_MAX_AGE=60

# Set to 1 to keep Supabase's session-mode pooler port when your DATABASE_URL
# points at *.pooler.supabase.com:5432 (not recommended for serverless).
# SUPABASE_USE_SESSION_POOLER=0

# Email settings (optional)
EMAIL_HOST_USER=youremail@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=Mushroom Farm <youremail@example.com>
ADMIN_EMAIL=youremail@example.com
SITE_URL=https://kabutomate-dan-f468.vercel.app

# ESP32 device API key. Put the same value in the firmware's apiKey constant.
ESP32_API_KEY=replace-with-a-long-random-device-key
WATER_REFILL_API_KEY=replace-with-a-separate-water-device-key
WATER_REFILL_DEVICE_ID=ESP32_WATER_REFILL_001
WATER_REFILL_OFFLINE_SECONDS=300

# Set true when the ESP32 is connected. Sensor data is sampled server-side
# according to SENSOR_MIN_INTERVAL_SECONDS, so the firmware interval is unchanged.
SENSOR_PROCESSING_ENABLED=false
SENSOR_MIN_INTERVAL_SECONDS=60

# Gemini AI assistant (keep this secret and set it in your local .env/deployment environment)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Local MySQL fallback (used only when DATABASE_URL is not set)
MYSQL_DB_NAME=mushroom_db
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
